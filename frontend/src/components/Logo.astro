---
interface Props {
  size?: "sm" | "md" | "lg";
  showText?: boolean;
}

const {
  size = "md",
  showText = true,
} = Astro.props;

const sizes = {
  sm: {
    icon: "h-8 w-8",
    text: "text-xl",
    gap: "gap-2",
  },

  md: {
    icon: "h-10 w-10",
    text: "text-2xl",
    gap: "gap-3",
  },

  lg: {
    icon: "h-12 w-12",
    text: "text-3xl",
    gap: "gap-4",
  },
};

const s = sizes[size];
---

<a
  href="/"
  class={`inline-flex items-center ${s.gap}`}
>
  <img
    src="/logo/logo_icon.svg"
    alt="PixelShrinkAI"
    class={s.icon}
    loading="eager"
    decoding="async"
  />

  {
    showText && (
      <span class={`font-extrabold tracking-tight text-slate-900 dark:text-white ${s.text}`}>
        PixelShrink<span class="text-blue-600">AI</span>
      </span>
    )
  }
</a>