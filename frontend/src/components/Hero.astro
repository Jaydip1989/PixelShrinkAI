---
import UploadCard from "./UploadCard.astro";
---

<section class="relative overflow-hidden bg-gradient-to-b from-white via-blue-50 to-white
  dark:from-slate-950 dark:via-slate-900 dark:to-slate-950 pt-32 pb-24">

  <div
  class="mx-auto grid max-w-7xl items-center gap-20 px-6
  lg:grid-cols-[1.05fr_0.95fr]"
>
    <!-- LEFT COLUMN -->
      <div class="max-w-[620px]">
          <!-- Launch Badge -->
          <span 
            class = "inline-flex items-center rounded-full border border-blue-200 bg-blue-100 px-4 py-1 text-sm 
            font-medium text-blue-700"
          >
            🚀 Launching Soon
          </span>

          <!-- Heading --> 
          <h1
            class = "mt-8 text-5xl font-extrabold leading-tight tracking-tight text-slate=900 dark:text-white md:text-5xl"
          >
            Powerful Image Tools.
            <span
              class = "block bg-gradient-to-r from-blue-500 via-indigo-600 to-pink-500 bg-clip-text text-transparent"
            >
            Fast. Private. Free.
            </span>
          </h1>

          <!-- Description -->
          <p class="mt-8 text-lg leading-8 text-slate-600 dark:text-slate-300">
            PixelShrinkAI is building a modern collection of online image tools
            to help you compress, resize, crop, convert and optimize images
            directly in your browser - with speed, privacy and simplicity.
          </p>

          <!-- Buttons -->
          <div class = "mt-10 flex flex-col gap-4 sm:flex-row">
            <a
              href = "#notify"
              class = "rounded-2xl bg-blue-600 px-8 py-4 font-semibold text-white transition-all
              duration-300 hover:-translate-y-1 hover:bg-blue-700 hover:shadow-lg"
            >
              Notify Me
            </a>
            <a
              href="#tools"
              class = "rounded-2xl border border-slate-300 px-8 py-4 font-semibold text-slate-700 transition-all
              duration-300 hover:border-blue-600 hover:text-blue-600"
            >
              Upcoming Tools
            </a>
          </div>
      </div>
      <!-- RIGHT COLUMN -->
      <div class = "flex justify-center">
        <div class="flex justify-end">
          <UploadCard />
        </div>
      </div>
  </div>
</section>