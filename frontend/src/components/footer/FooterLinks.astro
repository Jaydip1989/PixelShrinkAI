---
interface Props {
  title: string;
  links: { label: string; href: string }[];
}
const { title, links } = Astro.props;
---

<div class="footer-link-group">
  <h4 class="text-xs font-semibold uppercase tracking-[0.18em] text-[#D8B76D]">
    {title}
  </h4>
  <ul class="mt-6 space-y-4">
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          class="footer-link text-slate-300 transition-colors duration-300 hover:text-[#FFE18A]"
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .footer-link {text-decoration-color:transparent;text-underline-offset:5px;}
  .footer-link:hover {text-decoration-line:underline;text-decoration-color:rgba(255,211,120,.65);}
</style>
