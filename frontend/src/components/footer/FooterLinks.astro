---
interface Props {
  title: string;
  links: { label: string; href: string }[];
}

const { title, links } = Astro.props;
---

<div>

  <h4 class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">
    {title}
  </h4>

  <ul class="mt-6 space-y-4">

    {links.map((link) => (

      <li>

        <a
          href={link.href}
          class="text-slate-700 transition-colors duration-300 hover:text-blue-600 dark:text-slate-300 dark:hover:text-blue-400"
        >
          {link.label}
        </a>

      </li>

    ))}

  </ul>

</div>