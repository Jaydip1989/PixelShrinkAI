---
import Logo from "../Logo.astro";
import FooterSocials from "./FooterSocials.astro";
---

<div class="max-w-sm">

  <Logo />

  <h3 class="mt-7 text-2xl font-bold text-slate-900 dark:text-white">
    Fast. Private. Free.
  </h3>

  <p class="mt-4 leading-8 text-slate-600 dark:text-slate-400">
    Browser-based image tools built for speed, privacy and simplicity.
    Compress, resize, crop and convert images directly in your browser.
  </p>    

  <FooterSocials />

</div>