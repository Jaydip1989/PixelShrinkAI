---
import FooterBrand from "./FooterBrand.astro";
import FooterBottom from "./FooterBottom.astro";
import FooterLinks from "./FooterLinks.astro";
import featureMountain from "../../assets/feature-mountain-gold.png";

const product = [
  { label: "Image Compressor", href: "#" },
  { label: "Image Resizer", href: "#" },
  { label: "Crop Images", href: "#" },
  { label: "Format Converter", href: "#" },
];
const company = [
  { label: "About", href: "#about" },
  { label: "Roadmap", href: "#roadmap" },
  { label: "Contact", href: "#contact" },
  { label: "Blog", href: "#" },
];
const legal = [
  { label: "Privacy Policy", href: "#privacy-policy" },
  { label: "Terms & Conditions", href: "#terms-conditions" },
];

const support = [
  { label: "FAQ", href: "#" },
  { label: "Changelog", href: "#" },
  { label: "Status", href: "#" },
];
---

<footer class="golden-footer relative isolate overflow-hidden border-t border-[#D4A64A]/65 pt-10 pb-6 text-white">
  <div aria-hidden="true" class="footer-mountain-art pointer-events-none absolute inset-x-0 bottom-0">
    <img src={featureMountain.src} alt="" loading="lazy" decoding="async" />
  </div>
  <div aria-hidden="true" class="footer-gold-atmosphere pointer-events-none absolute inset-0"></div>
  <div aria-hidden="true" class="footer-top-glint pointer-events-none absolute inset-x-0 top-0 h-px"></div>
  <div class="relative z-10 mx-auto max-w-7xl px-6">
    <div class="grid grid-cols-2 gap-x-8 gap-y-10 md:grid-cols-2 md:gap-12 lg:grid-cols-[1.6fr_1fr_1fr_1fr_1fr] lg:gap-10">
      <div class="col-span-2 md:col-span-2 lg:col-span-1">
        <FooterBrand />
      </div>

      <FooterLinks title="Product" links={product} />
      <FooterLinks title="Company" links={company} />
      <FooterLinks title="Legal" links={legal} />
      <FooterLinks title="Support" links={support} />
    </div>
    <FooterBottom />
  </div>
</footer>

<dialog
  id="privacy-policy-dialog"
  aria-labelledby="privacy-policy-title"
  class="legal-dialog"
>
  <div class="legal-dialog-header">
    <h2 id="privacy-policy-title">Privacy Policy</h2>
    <button
      type="button"
      class="legal-dialog-close"
      aria-label="Close Privacy Policy"
      data-close-legal
    >
      &times;
    </button>
  </div>

  <div class="legal-dialog-content">
    <p><strong>Effective date:</strong> November 21, 2026</p>

    <h3>1. About this policy</h3>
    <p>
      PixelShrinkAI (“we,” “us,” or “our”) provides tools for image and
      document processing. This policy explains how information is handled
      when you visit or use the website.
    </p>

    <h3>2. Files you submit</h3>
    <p>
      When you use a conversion tool, you provide a file for processing.
      Files are processed to provide the conversion you request. Many
      operations process data in memory; some SVG-to-PDF operations use
      temporary files that the application attempts to remove after
      processing.
    </p>
    <p>
      PixelShrinkAI does not intentionally retain submitted files as a
      permanent user file library. Temporary processing and infrastructure
      behavior may vary, and we cannot guarantee that data is never present
      in temporary infrastructure or operational logs maintained by service
      providers.
    </p>

    <h3>3. Information you provide</h3>
    <p>
      If you contact us by email, we receive your email address, message,
      and any information you choose to include. We use it to respond to
      your request.
    </p>
    <p>
      The current early-access registration field is disabled. The website
      does not collect email addresses through that preview field.
    </p>

    <h3>4. How information is used</h3>
    <p>
      Information may be used to provide requested tools, respond to
      messages, maintain and secure the service, troubleshoot issues, and
      meet applicable legal obligations. We do not use the contents of
      submitted files for advertising.
    </p>

    <h3>5. Browser storage, cookies, and advertising</h3>
    <p>
      PixelShrinkAI uses browser local storage to remember your selected
      theme. This preference is stored in your browser and is not a cookie.
    </p>
    <p>
      If advertisements are displayed on PixelShrinkAI, Google AdSense or
      other advertising partners may use cookies or similar technologies
      to serve, personalize, and measure advertisements, subject to your
      applicable privacy and consent choices. These providers may receive
      information about your browser, device, or visits to this and other
      websites. PixelShrinkAI does not use advertising technologies to store
      uploaded images.
    </p>
    <p>
      For information about how Google uses data from sites or apps that use
      its services, visit
      <a
        href="https://policies.google.com/technologies/ads"
        target="_blank"
        rel="noopener noreferrer"
      >Google's Advertising and Privacy information</a>.
    </p>

    <h3>6. Service providers</h3>
    <p>
      Hosting and infrastructure providers may process technical information
      as part of delivering, securing, or maintaining the service. Their
      practices and retention settings are governed by their own terms and
      configurations.
    </p>

    <h3>7. Your choices</h3>
    <p>
      You can choose not to submit a file or contact us. You may contact us
      with questions about information you have provided, subject to
      applicable law and technical limitations.
    </p>

    <h3>8. Children</h3>
    <p>
      PixelShrinkAI is not intended to be directed to children. If you
      believe a child has provided personal information to us, contact us
      so we can review the matter.
    </p>

    <h3>9. Changes to this policy</h3>
    <p>
      We may update this policy as the website and its features change.
      The effective date above indicates when it was last updated.
    </p>

    <h3>10. Contact</h3>
    <p>
      For privacy questions or requests, email:
      <a href="mailto:hello@pixelshrinkai.com"> hello@pixelshrinkai.com</a>.
    </p>
    <p>PixelShrinkAI · Mira-Bhayandar, Maharashtra, India</p>
  </div>
</dialog>

<dialog
  id="terms-conditions-dialog"
  aria-labelledby="terms-conditions-title"
  class="legal-dialog"
>
  <div class="legal-dialog-header">
    <h2 id="terms-conditions-title">Terms & Conditions</h2>
    <button
      type="button"
      class="legal-dialog-close"
      aria-label="Close Terms & Conditions"
      data-close-legal
    >
    </button>
  </div>

  <div class="legal-dialog-content">
    <p><strong>Effective date:</strong> November 21, 2026</p>

    <h3>1. About PixelShrinkAI</h3>
    <p>
      PixelShrinkAI provides browser-based tools for image and document
      processing. These Terms govern your access to and use of the website
      and its tools.
    </p>

    <h3>2. Using the service</h3>
    <p>
      You may use the service only for lawful purposes and in accordance with
      these Terms. You are responsible for ensuring that your use of the tools
      complies with applicable laws and any rights that apply to your files.
    </p>

    <h3>3. Your files and content</h3>
    <p>
      You retain any rights you hold in files you submit. You confirm that
      you have the rights and permissions needed to submit and process them.
      You are responsible for keeping your own copies of original files and
      any outputs you wish to retain.
    </p>

    <h3>4. Outputs and accuracy</h3>
    <p>
      Processing results may vary depending on the file, format, settings,
      and tool used. Review each output before relying on it. We do not
      guarantee that every conversion or result will meet your requirements.
    </p>

    <h3>5. Acceptable use</h3>
    <p>
      You must not use the service to violate the law or another person's
      rights, interfere with the website, attempt unauthorized access, or
      upload files containing malware or other harmful code.
    </p>

    <h3>6. Availability and changes</h3>
    <p>
      We may update, suspend, or discontinue features as the service develops.
      We aim to keep the website available but do not guarantee uninterrupted
      or error-free operation.
    </p>

    <h3>7. Disclaimer</h3>
    <p>
      To the extent permitted by applicable law, the service is provided
      “as is” and “as available,” without warranties of any kind, whether
      express or implied.
    </p>

    <h3>8. Limitation of liability</h3>
    <p>
      To the extent permitted by applicable law, PixelShrinkAI will not be
      liable for indirect, incidental, special, consequential, or punitive
      damages, or for loss of data, profits, or business arising from your
      use of the service.
    </p>

    <h3>9. Changes to these Terms</h3>
    <p>
      We may revise these Terms as the service changes. The effective date
      above indicates when they were last updated. Continued use of the
      service after changes take effect means you accept the revised Terms,
      to the extent permitted by law.
    </p>

    <h3>10. Contact</h3>
    <p>
      For questions about these Terms, email:
      <a href="mailto:hello@pixelshrinkai.com"> hello@pixelshrinkai.com</a>.
    </p>
  </div>
</dialog>

<script>
  document.addEventListener("click", (event) => {
    const target = event.target;

    if (!(target instanceof Element)) return;

    const legalLink = target.closest(
      'a[href="#privacy-policy"], a[href="#terms-conditions"]',
    );

    if (legalLink) {
      const href = legalLink.getAttribute("href");
      let dialogId: string | null = null;

      switch (href) {
        case "#privacy-policy":
          dialogId = "privacy-policy-dialog";
          break;
        case "#terms-conditions":
          dialogId = "terms-conditions-dialog";
          break;
      }

      const dialog = dialogId
        ? document.getElementById(dialogId)
        : null;

      if (dialog instanceof HTMLDialogElement) {
        event.preventDefault();
        dialog.showModal();
      }

      return;
    }

    const closeButton = target.closest("[data-close-legal]");

    if (closeButton) {
      const dialog = closeButton.closest("dialog");

      if (dialog instanceof HTMLDialogElement) {
        dialog.close();
      }
    }
  });
</script>

<style>
.golden-footer {
 background:
  linear-gradient(180deg,rgba(5,12,25,.99) 0%,rgba(5,12,25,.90) 32%,rgba(3,9,22,.48) 68%,rgba(3,9,22,.30) 100%),
  radial-gradient(ellipse 52% 64% at 10% 0%,rgba(255,178,47,.14),transparent 76%),
  radial-gradient(ellipse 48% 72% at 100% 18%,rgba(37,99,235,.16),transparent 78%),
  linear-gradient(180deg,#07101F 0%,#030916 100%);
 box-shadow:inset 0 18px 52px rgba(255,179,50,.045);
}
.footer-mountain-art {z-index:0;height:clamp(340px,43vw,540px);overflow:hidden;opacity:.96;}
.footer-mountain-art::after {content:"";position:absolute;inset:0;background:linear-gradient(180deg,#07101F 0%,rgba(7,16,31,.88) 8%,rgba(7,16,31,.35) 35%,rgba(3,9,22,.08) 72%,rgba(3,9,22,.25) 100%);}
.footer-mountain-art img {display:block;width:100%;height:100%;object-fit:cover;object-position:center bottom;mix-blend-mode:screen;opacity:.95;}
.footer-gold-atmosphere::before,.footer-gold-atmosphere::after {content:"";position:absolute;pointer-events:none;border-radius:50%;}
.footer-gold-atmosphere::before {
  left: -18%;
  top: 10%;
  width: 76%;
  height: 64%;
  border: 2px solid transparent;
  border-top-color: rgba(255,190,65,.42);
  transform: rotate(-7deg);
  filter: drop-shadow(0 0 9px rgba(255,176,48,.32));
}
.footer-gold-atmosphere::after {right:-20%;bottom:0%;width:76%;height:64%;border:2px solid transparent;border-top-color:rgba(82,151,255,.38);transform:rotate(8deg);filter:drop-shadow(0 0 10px rgba(37,99,235,.28));}
.footer-top-glint {background:linear-gradient(90deg,transparent,rgba(255,206,111,.40),rgba(255,240,189,.24),rgba(255,206,111,.40),transparent);box-shadow:0 0 10px rgba(255,184,54,.28);}
@media (max-width:767px) {.footer-mountain-art {height:340px;opacity:.76;}.footer-mountain-art img {object-position:center bottom;}}

.legal-dialog {
  position: fixed;
  inset: 0;
  margin: auto;
  box-sizing: border-box;
  width: min(92vw, 760px);
  max-width: 760px;
  max-height: 85vh;
  padding: 0;
  border: 1px solid rgba(212, 166, 74, 0.55);
  border-radius: 18px;
  color: #e2e8f0;
  background: #07101f;
  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.55);
}


.legal-dialog::backdrop {
  background: rgba(2, 6, 18, 0.78);
  backdrop-filter: blur(5px);
}

.legal-dialog-header {
  position: sticky;
  top: 0;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 1.25rem 1.5rem;
  border-bottom: 1px solid rgba(212, 166, 74, 0.25);
  background: #07101f;
}

.legal-dialog-header h2 {
  margin: 0;
  color: #f5d27a;
  font-size: 1.25rem;
  font-weight: 700;
}

.legal-dialog-close {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.5rem;
  height: 2.5rem;
  flex: 0 0 auto;
  padding: 0;
  border: 1px solid rgba(226, 232, 240, 0.2);
  border-radius: 999px;
  color: #e2e8f0;
  background: transparent;
  font-size: 0;
  line-height: 1;
  cursor: pointer;
}


.legal-dialog-close::before,
.legal-dialog-close::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0.9rem;
  height: 2px;
  border-radius: 2px;
  background: currentColor;
  transform-origin: center;
}

.legal-dialog-close::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.legal-dialog-close::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.legal-dialog-close:hover {
  color: #f5d27a;
  border-color: rgba(245, 210, 122, 0.65);
}

.legal-dialog-content {
  max-height: calc(85vh - 5rem);
  overflow-y: auto;
  padding: 1.5rem;
  line-height: 1.7;
  overflow-wrap: anywhere;
}

.legal-dialog-content h3 {
  margin: 1.5rem 0 0.5rem;
  color: #f5d27a;
  font-size: 1rem;
  font-weight: 700;
}

.legal-dialog-content p {
  margin: 0.75rem 0;
}

.legal-dialog-content a {
  color: #f5d27a;
  text-decoration: underline;
  text-underline-offset: 3px;
}

@media (max-width: 640px) {
  .legal-dialog {
    width: calc(100vw - 1.25rem);
    max-height: 88vh;
    border-radius: 14px;
  }

  .legal-dialog-header {
    padding: 1rem;
  }

  .legal-dialog-content {
    max-height: calc(88vh - 4.5rem);
    padding: 1rem;
  }
}
</style>
