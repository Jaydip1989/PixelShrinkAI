---
import type { Tool } from '../../data/tools';

interface Props {
    tool: Tool;
}

const { tool } = Astro.props;
const Icon = tool.icon;

const badgeStyles = {
    live: "bg-green-100 text-green-700",
    coming: "bg-blue-100 text-blue-700",
    planned:"bg-orange-100 text-orange-700",
};

const badgeText = {
    live:"Live",
    coming:"Coming Soon",
    planned:"Planned",
};
---

<a
    href = {tool.href}
    class="
        group
        flex
        flex-col
        rounded-3xl
        border
        border-slate-200
        bg-white
        p-6
        shadow-sm
        transition-all
        duration-300
        hover:-translate-y-1
        hover:shadow-xl
        dark:border-slate-700
        dark:bg-slate-900
        dark:hover:border-blue-500/40
    "
>
    <!-- Icon -->
    <div
        class="
            mb-5
            flex
            h-16
            w-16
            items-center
            justify-center
            rounded-2xl
            bg-gradient-to-br
            text-white
            shadow-lg
        "
    >
        <Icon size={32} strokeWidth={2.2} />
    </div>

    <!-- Title -->
    <h3 class="text-lg 
            font-old 
            text-slate-900 
            dark:text-white
    ">
        {tool.title}
    </h3>

    <!-- Description -->
    <p class="
        mt-2 
        flex-1
        text-sm 
        leading-6 
        text-slate-600 
        dark:text-slate-400
        "
    >
        {tool.description}
    </p>

    <!-- Badge -->
    <span
        class:list={[
            "mt-6 inline-flex w-fit rounded-full px-3 py-1 text-xs font-semibold",
            badgeStyles[tool.status],
        ]}
    >
        {badgeText[tool.status]}
    </span>
</a>