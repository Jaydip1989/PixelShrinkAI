---
import ToolCard from "./ToolCard.astro";
import { TOOLS } from "../../data/tools";
---
<section
  id="tools"
  class="mx-auto max-w-7xl px-6 py-24"
>
  <!-- Section Badge -->
  <div class="flex justify-center">
    <span
      class="
        inline-flex
        items-center
        gap-2
        rounded-full
        border
        border-blue-200
        bg-blue-50
        px-4
        py-1.5
        text-sm
        font-semibold
        text-blue-700
      "
    >
      🚀 Our Roadmap
    </span>
  </div>
  <!-- Heading -->
  <h2
    class="
      mt-6
      text-center
      text-4xl
      font-bold
      text-slate-900
      dark:text-white
    "
  >
    Image Tools
  </h2>
  <p
    class="
      max-auto
      mt-5
      max-w-2xl
      text-center
      text-lg
      text-slate-600
      dark:text-slate-400
    "
  >
    Everything you need to optimize, resize, crop,
    convert and enhance your images directly in your browser
  </p>
  <div
    class = "
      mt-16
      grid
      gap-8
      sm:grid-cols-2
      lg:grid-cols-4
    "
  >
    {
      TOOLS.map((tool) => (
        <ToolCard tool = {tool} />

      ))
    }
  </div>
</section>
