---
import HeroGlow from "./HeroGlow.astro";
import DotPattern from "./DotPattern.astro";
import FloatingToolIcons from "./FloatingToolIcons.astro";
import CompressionBadge from "./CompressionBadge.astro";
import SmallPluses from "./SmallPluses.astro";
---

<div
  class=" pointer-events-none
    absolute
    inset-0
    overflow-hidden
    select-none
    aria-hidden
  "
>
  <!-- Soft Background Glow -->
  <div
    class="
      absolute
      inset-0
      z-0
      overflow-hidden
    "
  >
    <HeroGlow />
  </div>

  <!-- Dot Pattern -->
  <div
    class="
      absolute
      left-4
      top-24
      z-10
      hidden

      lg:block
      xl:left-6
      xl:top-20
    "
  >
    <DotPattern />
  </div>

  <!-- Workspace Decoration Layer -->

  <div
    class="
      absolute
      inset-0
      z-20
      hidden

      lg:block
    "
  >
        <!-- Floating Tool Icons -->
    <FloatingToolIcons />

    <!-- Compression Badge -->
    <CompressionBadge />

    <!-- Small Decorative Pluses -->
    <SmallPluses />

  </div>
</div>