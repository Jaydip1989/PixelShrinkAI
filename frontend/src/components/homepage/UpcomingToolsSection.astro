---
import {
  Image, ScanSearch, Sparkles, Scaling, PencilRuler, Stamp, WandSparkles, ShieldCheck
} from "lucide-preact";
import UpcomingTool from "./UpcomingTool.astro";
---

<section id="tools" class="golden-tools-section relative isolate overflow-hidden border-b border-[#D4A64A]/65 px-4 pb-8 pt-8 sm:px-6 lg:px-8">
  <div aria-hidden="true" class="tools-gold-wash pointer-events-none absolute inset-0"></div>
  <div aria-hidden="true" class="tools-top-glint pointer-events-none absolute inset-x-0 top-0 h-px"></div>
  <div class="relative z-10 mx-auto max-w-[1475px]">
    <div class="golden-tool-grid grid grid-cols-2 gap-4 sm:grid-cols-4 lg:grid-cols-8 lg:gap-3.5">
      <UpcomingTool title="Compressor" description="Reduce file size without losing quality." status="live" variant="emerald" featured><Image size={30} strokeWidth={2.2} /></UpcomingTool>
      <UpcomingTool title="Converter" description="Convert between JPG, PNG, WEBP, AVIF, PDF, SVG and more." status="live" variant="violet" featured><ScanSearch size={30} strokeWidth={2.2} /></UpcomingTool>
      <UpcomingTool title="AI Enhancer" description="Improve image quality with AI." status="coming-soon" variant="blue"><Sparkles size={30} strokeWidth={2.2} /></UpcomingTool>
      <UpcomingTool title="Resizer" description="Resize images with custom dimensions and presets." status="planned" variant="amber"><Scaling size={30} strokeWidth={2.2} /></UpcomingTool>
      <UpcomingTool title="Editor" description="Crop, rotate and make quick edits." status="planned" variant="rose"><PencilRuler size={30} strokeWidth={2.2} /></UpcomingTool>
      <UpcomingTool title="Watermark Remover" description="Remove unwanted watermarks." status="planned" variant="emerald"><Stamp size={30} strokeWidth={2.2} /></UpcomingTool>
      <UpcomingTool title="Background Remover" description="Remove background with AI." status="planned" variant="emerald"><WandSparkles size={30} strokeWidth={2.2} /></UpcomingTool>
      <UpcomingTool title="Metadata Cleaner" description="View and remove image metadata." status="planned" variant="violet"><ShieldCheck size={30} strokeWidth={2.2} /></UpcomingTool>
    </div>
  </div>
</section>

<style>
.golden-tools-section {
 background:
  radial-gradient(ellipse 58% 75% at 50% 0%,rgba(255,190,65,.22),transparent 74%),
  radial-gradient(ellipse 34% 90% at 0% 50%,rgba(37,99,235,.22),transparent 75%),
  radial-gradient(ellipse 34% 90% at 100% 50%,rgba(37,99,235,.2),transparent 75%),
  linear-gradient(180deg,#030916 0%,#090F1E 58%,#030916 100%);
}
.tools-gold-wash::before,.tools-gold-wash::after {content:"";position:absolute;pointer-events:none;border-radius:50%;}
.tools-gold-wash::before {left:-12%;top:4%;width:72%;height:86%;border:2px solid transparent;border-top-color:rgba(255,202,91,.78);border-bottom-color:rgba(255,177,50,.26);transform:rotate(-5deg);filter:drop-shadow(0 0 8px rgba(255,176,45,.7)) drop-shadow(0 0 22px rgba(255,176,45,.25));}
.tools-gold-wash::after {right:-15%;top:12%;width:68%;height:76%;border:2px solid transparent;border-top-color:rgba(93,160,255,.65);border-bottom-color:rgba(255,194,72,.32);transform:rotate(7deg);filter:drop-shadow(0 0 9px rgba(37,99,235,.48)) drop-shadow(0 0 22px rgba(255,176,45,.18));}
.tools-top-glint {background:linear-gradient(90deg,transparent,rgba(255,211,120,.64),rgba(255,240,189,.45),rgba(255,211,120,.64),transparent);box-shadow:0 0 14px rgba(255,190,65,.42);}
@media (min-width:1024px) {.golden-tool-grid {grid-template-columns:repeat(8,minmax(0,1fr));}}
</style>
