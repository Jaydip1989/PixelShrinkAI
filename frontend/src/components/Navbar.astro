---
import ThemeToggle from "./ThemeToggle.astro";

const navItems = [
  { name: "Tools", href: "#tools" },
  { name: "Features", href: "#features" },
  { name: "About", href: "#about" },
  { name: "Roadmap", href: "#roadmap" },
  { name: "Contact", href: "#contact" },
];
---

<header class="fixed inset-x-0 top-0 z-50 bg-white dark:bg-slate-900
    dark:border-slate-800  transition-colors duration-300">
  <div class="mx-auto max-w-[1400px] px-6 pt-3 pb-2">
    <nav
      class="flex 
      h-[64px]  
      items-center 
      justify-between 
      rounded-[32px] 
      border 
      border-slate-200 
      bg-white 
      dark:bg-slate-900
      dark:border-slate-700
      px-10 
      shadow-[0_8px_24px_rgba(15, 23, 42, 0.08)]
      dark:shadow-[0_8px_24px_rgba(0,0,0,0.45)]"
    >

      <!-- Logo -->
      <a href="/"  
        aria-label = "Go to PixelShrinkAI homepage"
        class="flex items-center justify-center"
      >
        <!-- Light Logo -->
          <img
            src="/logo/logo.svg"
            alt="PixelShrinkAI"
            class="block h-8 sm:h-10 lg:h-[46px] w-auto dark:hidden"
          />

          <!-- Dark Logo -->
          <img
            src="/logo/logo-dark.svg"
            alt="PixelShrinkAI"
            class="hidden h-8 sm:h-10 lg:h-[46px] w-auto dark:block"
          />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden items-center gap-10 lg:flex">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="text-[16px] font-medium text-slate-800 dark:text-slate-200 transition-colors duration-200 hover:text-blue-600"
            >
              {item.name}
            </a>
          ))
        }
      </div>

      <!-- CTA -->

      <ThemeToggle />

      <a
        href="#notify"
        class="
          inline-flex items-center justify-center gap-1.5
          rounded-2xl
          bg-gradient-to-r
          from-blue-600
          to-indigo-600

          px-2.5 py-2
          min-[400px]:px-3
          sm:px-5
          lg:px-7

          text-xs
          min-[400px]:text-sm
          font-semibold
          text-white
          shadow-md
          transition-all
          duration-300
          hover:-translate-y-0.5
          hover:shadow-lg
        "
      >

        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
          <path d="M10.3 21a2 2 0 0 0 3.4 0" />
        </svg>

        <!-- Desktop -->
        <span class="hidden sm:inline">
          Notify Me
        </span>

        <!-- Mobile -->
        <span class="sm:hidden">
          Notify
        </span>

      </a>

    </nav>

  </div>
</header>