---
const navItems = [
  { name: "Tools", href: "#tools" },
  { name: "Features", href: "#features" },
  { name: "About", href: "#about" },
  { name: "Roadmap", href: "#roadmap" },
  { name: "Contact", href: "#contact" },
];
---

<header class="fixed inset-x-0 top-5 z-50">
  <div class="mx-auto max-w-[1400px] px-6">

    <nav
      class="flex h-[72px] items-center justify-between
      rounded-[28px]
      border border-white/60 
      bg-white/90
      px-10
      shadow-[0_12px_35px_rgba(37, 99, 235, 0.08)]
      backdrop-blur-xl">

      <!-- Logo -->
      <a href="/"  
        aria-label = "Go to PixelShrinkAI homepage"
        class="flex items-center justify-center"
      >
        <img
          src="/logo/logo.svg"
          alt="PixelShrinkAI"
          class="h-[46px] w-auto"
        />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden items-center gap-12 lg:flex">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="text-[16px] font-medium text-slate-800 transition-colors duration-200 hover:text-blue-600"
            >
              {item.name}
            </a>
          ))
        }
      </div>

      <!-- CTA -->
      <a
        href="#notify"
        class="inline-flex items-center gap-2 rounded-2xl
        bg-gradient-to-r
        from-blue-600
        to-indigo-600
        px-6 py-3
        text-sm
        font-semibold
        text-white
        shadow-lg
        shadow-blue-300/40
        transition-all
        duration-300
        hover:-translate-y-0.5
        hover:bg-blue-700
        hover:shadow-lg">

        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
          <path d="M10.3 21a2 2 0 0 0 3.4 0" />
        </svg>

        Notify Me

      </a>

    </nav>

  </div>
</header>