
---
import ThemeToggle from "./ThemeToggle.astro";

const navItems = [
  { name: "Tools", href: "#tools", dropdown: true },
  { name: "Features", href: "#features", dropdown: false },
  { name: "About", href: "#about", dropdown: false },
  { name: "Roadmap", href: "#roadmap", dropdown: false },
  { name: "Contact", href: "#contact", dropdown: false },
];
---

<header class="fixed inset-x-0 top-0 z-50 w-full bg-[#050A16] px-3 pt-3 sm:px-5 lg:px-8 dark:bg-[#050A16]">
  <div class="relative isolate mx-auto max-w-[1440px]">

    <!-- Golden ambient lighting behind navbar -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -inset-x-8 -inset-y-5 z-0 overflow-visible"
    >
      <!-- Main golden light trail -->
      <div
        class="absolute inset-x-[3%] bottom-[-9px] h-12 rounded-full
        bg-[radial-gradient(ellipse_at_center,rgba(245,185,66,0.48),rgba(212,155,46,0.16)_42%,transparent_75%)]
        blur-xl"
      ></div>

      <!-- Left corner glow -->
      <div
        class="absolute left-[1%] top-1/2 h-16 w-32 -translate-y-1/2
        rounded-full bg-amber-400/20 blur-2xl"
      ></div>

      <!-- Right corner glow -->
      <div
        class="absolute right-[1%] top-1/2 h-16 w-32 -translate-y-1/2
        rounded-full bg-amber-400/20 blur-2xl"
      ></div>

      <!-- Fine gold upper light -->
      <div
        class="absolute inset-x-[5%] top-[2px] h-px
        bg-gradient-to-r from-transparent via-[#FFD978]/70 to-transparent"
      ></div>

      <!-- Left illuminated streak -->
      <div
        class="absolute -left-2 bottom-[-3px] h-5 w-28 rotate-[-8deg]
        rounded-full bg-[#F5B942]/30 blur-lg"
      ></div>

      <!-- Right illuminated streak -->
      <div
        class="absolute -right-2 bottom-[-3px] h-5 w-28 rotate-[8deg]
        rounded-full bg-[#F5B942]/30 blur-lg"
      ></div>
    </div>

    <!-- Main navbar -->
    <nav
      aria-label="Main navigation"
      class="relative z-10 flex min-h-[62px] w-full items-center
      justify-between gap-3 rounded-full
      border border-[#D4A64A]/75
      bg-[#050A16] px-4
      shadow-[0_0_0_1px_rgba(212,166,74,0.16),0_0_15px_rgba(212,166,74,0.18),0_5px_24px_rgba(0,0,0,0.65),inset_0_1px_0_rgba(255,217,120,0.12)]
      sm:min-h-[68px] sm:px-6 lg:px-8"
    >

      <!-- Brand -->
      <a
        href="/"
        aria-label="PixelShrinkAI homepage"
        class="flex shrink-0 items-center"
      >
        <img
          id="navbar-logo"
          src="/logo/logo-dark.svg"
          alt="PixelShrinkAI"
          class="h-9 w-auto sm:h-10"
        />
      </a>

      <!-- Desktop navigation -->
      <div class="hidden items-center gap-7 lg:flex xl:gap-10">

        {navItems.map((item) => (
          <a
            href={item.href}
            class="group inline-flex items-center gap-1.5
            whitespace-nowrap py-2 text-[13px] font-semibold
            text-slate-100 transition-colors
            hover:text-[#FFD978] xl:text-sm"
          >
            {item.name}

            {item.dropdown && (
              <svg
                aria-hidden="true"
                class="h-3 w-3 transition-transform duration-200
                group-hover:translate-y-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            )}

            <span
              class="absolute"
            ></span>
          </a>
        ))}
      </div>

      <!-- Right-side actions -->
      <div class="flex shrink-0 items-center gap-2 sm:gap-3">

        <!-- Theme toggle -->
        <div
          class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden
          rounded-full border border-[#D4A64A]/35
          bg-[#101827] shadow-[0_0_12px_rgba(245,185,66,0.12)]
          [&_button]:!h-10 [&_button]:!w-10
          [&_button]:!rounded-full [&_button]:!border-0
          [&_button]:!bg-transparent [&_button]:!shadow-none"
        >
          <ThemeToggle />
        </div>

        <!-- Notify Me -->
        <a
          href="#notify"
          class="inline-flex min-h-[40px] min-w-10 shrink-0 items-center justify-center
          gap-1.5 rounded-full
          bg-gradient-to-r from-[#1765FF] via-[#6845F5] to-[#C43BEE]
          px-3 text-[13px] font-bold text-white
          shadow-[0_0_16px_rgba(99,75,255,0.28)]
          transition-all duration-300
          hover:-translate-y-0.5
          hover:shadow-[0_0_22px_rgba(125,65,255,0.48)]
          sm:min-h-[44px] sm:px-4 sm:text-xs"
        >
          <svg
            aria-hidden="true"
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
            <path d="M10 21h4" />
          </svg>

          <span class="hidden sm:inline">Notify Me</span>
        </a>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-toggle"
          type="button"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-navigation"
          class="flex h-10 w-10 shrink-0 items-center justify-center
          rounded-full border border-[#D4A64A]/35
          text-white transition hover:text-[#FFD978] lg:hidden"
        >
          <svg
            id="mobile-menu-open-icon"
            aria-hidden="true"
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>

          <svg
            id="mobile-menu-close-icon"
            aria-hidden="true"
            class="hidden h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <path d="m18 6-12 12M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Mobile navigation -->
      <div
        id="mobile-navigation"
        class="absolute left-0 right-0 top-[calc(100%+12px)]
        hidden overflow-hidden rounded-2xl
        border border-[#D4A64A]/45 bg-[#080F1D]
        p-3 shadow-[0_8px_30px_rgba(0,0,0,0.55)]
        lg:hidden"
      >
        <div class="flex flex-col">
          {navItems.map((item) => (
            <a
              href={item.href}
              class="rounded-xl px-4 py-3 text-sm font-medium
              text-slate-100 transition
              hover:bg-[#17243A] hover:text-[#FFD978]"
            >
              {item.name}
            </a>
          ))}
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  // Mobile navigation
  const menuToggle = document.getElementById("mobile-menu-toggle");
  const mobileNavigation = document.getElementById("mobile-navigation");
  const openIcon = document.getElementById("mobile-menu-open-icon");
  const closeIcon = document.getElementById("mobile-menu-close-icon");

  function setMobileMenu(open: boolean) {
    if (!menuToggle || !mobileNavigation || !openIcon || !closeIcon) return;

    mobileNavigation.classList.toggle("hidden", !open);
    openIcon.classList.toggle("hidden", open);
    closeIcon.classList.toggle("hidden", !open);

    menuToggle.setAttribute("aria-expanded", String(open));
    menuToggle.setAttribute(
      "aria-label",
      open ? "Close navigation menu" : "Open navigation menu"
    );
  }

  menuToggle?.addEventListener("click", () => {
    const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
    setMobileMenu(!isOpen);
  });

  mobileNavigation?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMobileMenu(false));
  });

  document.addEventListener("click", (event) => {
    if (
      menuToggle &&
      mobileNavigation &&
      !menuToggle.contains(event.target as Node) &&
      !mobileNavigation.contains(event.target as Node)
    ) {
      setMobileMenu(false);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      setMobileMenu(false);
    }
  });
</script>
