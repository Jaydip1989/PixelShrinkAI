<section  
    class="    
    w-full    
    max-w-[640px]    
    min-h-[480px]     
    rounded-[30px]    
    border   
    border-slate-200   
    bg-white    
    p-6     
    shadow-[0_20px_60px_rgba(37,99,235,0.12)]    
    dark:border-slate-700   
    dark:bg-slate-800    
    dark:shadow-[0_20px_60px_rgba(0,0,0,0.35)]  ">

    <label 
        id="upload-zone"   
        for="image-upload"     
        class="group flex        
        h-full        
        flex-col        
        items-center        
        justify-center         
        rounded-[24px]         
        border        
        border-dashed       
        border-slate-300         
        px-8        
        py-8         
        text-center         
        transition-all duration-300        
        hover:border-blue-500       
        hover:bg-blue-50/40        
        dark:border-slate-600        
        dark:hover:border-blue-400        
        dark:hover:bg-slate-700/40 ">
        <input            
            id="image-upload"            
            type="file"            
            accept=".jpg,.jpeg,.png,.webp,.avif"            
            class="hidden" />

        <!-- Upload Icon -->
        
        <div            
        class="mb-5                 
        flex                
        h-14                
        w-14                 
        items-center                
        justify-center                 
        rounded-full                
        bg-blue-100               
        text-blue-600                 
        transition-all duration-300                 
        group-hover:-translate-y-1                
        group-hover:scale-105                 
        dark:bg-slate-700                
        dark:text-blue-400        
        ">

            <svg                
                xmlns="http://www.w3.org/2000/svg"                
                class="h-8 w-8"                
                fill="none"                
                viewBox="0 0 24 24"                
                stroke="currentColor"                
                stroke-width="2">             
                    <path            
                    stroke-linecap="round"            
                    stroke-linejoin="round"            
                    d="M12 16V4m0 0l-4 4m4-4l4 4M5 20h14"            
                    />             
            </svg>

        </div>
        
        <!-- Heading -->         
        <h3            
            class="            
                text-[20px]            
                font-bold            
                tracking-tight            
                text-slate-900            
                dark:text-white"
        >             
            Upload Image         
        </h3>


        <!-- Description -->         
        <p            
            class="            
            mt-2            
            max-w-md             
            text-lg            
            leading-8            
            text-slate-600            
            dark:text-slate-300">             
            Drag & Drop your image here         
                <br>         
                <span            
                    class="            
                        font-semibold            
                        text-blue-600            
                        dark:text-blue-400">             
                    or click anywhere to browse.         
                </span>         
            </p>
        <!-- Formats -->

        <div
        class="
        mt-6

        flex
        flex-wrap
        justify-center

        gap-3">

            <span class="rounded-full border border-slate-300 bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-200">

            JPG

            </span>

            <span class="rounded-full border border-slate-300 bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-200">

            PNG

            </span>

            <span class="rounded-full border border-slate-300 bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-200">

            WEBP

            </span>

            <span class="rounded-full border border-slate-300 bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-200">

            AVIF

            </span>

        </div>

        <!-- Button -->         
        <div class="mt-5">             
            <span                
                class="                
                inline-flex                 
                w-48                 
                items-center                
                justify-center                 
                rounded-2xl                 
                bg-gradient-to-r                
                from-blue-600                
                to-indigo-600
                px-8                
                py-4                 
                text-lg                
                font-semibold                 
                text-white                 
                shadow-lg                 
                transition-all duration-300                 
                group-hover:scale-[1.03]">
                    Select Image
            </span>
            </div>
        <!-- File Size -->         
        <p           
            class="mt-5             
            text-sm             
            font-medium             
            text-slate-500            
            dark:text-slate-400">             
                Maximum file size: 25 MB        
        </p> 
        <p
            id="upload-error"
            class="mt-2 hidden text-sm font-medium text-red-500"
        >
        </p>
    </label>
<script type="module" >
    import "../../scripts/imageUploader";
</script>
    
</section>