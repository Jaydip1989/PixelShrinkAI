---
import ImagePreview  from "../ImagePreview.astro";
import FileInfo from "../FileInfo.astro";
import CompressionControls from "../CompressionControls.astro";
---

<div class="space-y-6 p-6">
    <ImagePreview />
    <div 
        class="
            rounded-xl
            border
            border-slate-200
            p-4
            dark:border-slate-700
        "
    >
        <FileInfo />
    </div>
    <div
        class = "
            rounded-xl
            border
            border-slate-200
            p-4
            dark:border-slate-700
        "
    >
        <CompressionControls />
    </div>
</div>