---
import WorkspaceHeader from "./WorkspaceHeader.astro";
import CompressorHero from "./CompressorHero";
import WorkspaceFooter from "./WorkspaceFooter.astro";
---

<section
  aria-label="Image compressor workspace"
  class="
    relative
    w-full
    max-w-[520px]
    overflow-hidden
    rounded-[32px]
    border
    border-slate-200/80
    bg-white/95
    shadow-[0_24px_70px_rgba(37,99,235,0.12)]
    backdrop-blur-sm
    transition-all
    duration-300

    lg:max-w-[500px]
    xl:max-w-[520px]

    dark:border-slate-700/80
    dark:bg-slate-900/95
    dark:shadow-[0_28px_80px_rgba(0,0,0,0.55)]
  "
>
  <WorkspaceHeader />

  <CompressorHero client:load />

  <WorkspaceFooter />
  
</section>