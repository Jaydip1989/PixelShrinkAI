---
import UploadState from "./states/UploadState.astro";
import PreviewState from "./states/PreviewState.astro";
import ProcessingState from "./states/ProcessingState.astro";
import DownloadState from "./states/DownloadState.astro";
---

<div class="flex flex-col">
    <div id="upload-state">
        <UploadState />
    </div>

    <div id="preview-state" class="hidden">
        <PreviewState />
    </div>

    <div id="processing-state" class="hidden">
        <ProcessingState />
    </div>
    
    <div id="download-state" class="hidden">
        <DownloadState />
    </div>
    
</div>