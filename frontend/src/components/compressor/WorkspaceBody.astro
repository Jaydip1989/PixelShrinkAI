<div
    class="
        flex
        min-h-[340px]
        flex-col
    "
>
    <!-- Canvas -->
    <div
        id = "workspace-canvas"
        class = "
            flex
            flex-1
            flex-col
            items-center
            justify-center

            border-b
            border-slate-200

            px-3
            py-4

            dark:border-slate-700
            dark:bg-slate-800
        "
    >
        <!-- Upload Icon -->
        <div
            class = "
                mb-4
                flex
                h-16
                w-16

                items-center
                justify-center

                rounded-full
                bg-gradient-to-br
                from-blue-500
                via-indigo-500
                to-pink-500
                shadow-lg
            "
        >
            <svg
                xmlns="http://www.w3.org/200/svg"
                class = "h-10 w-10 text-white"
                fill = "none"
                viewBox = "0 0 24 24"
                stroke = "currentColor"
                stroke-width = "2"
            >
                <path 
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 16V4m0 0l-4 4m4-4l4 4M5 20h14"
                />
            </svg>
        </div>
        <h3
            class = "
                text-2xl
                font-bold
                text-slate-900

                dark:text-white
            "
        >
            Upload Image
        </h3>
        <p
            class = "
                mt-2
                text-center
                leading-7
                text-slate-600
                dark:text-slate-300
            "
        >
            Drag & Drop your image here
            <br />
            or click to browse
        </p>
        <div
            class = "
                mt-8
                flex
                flex-wrap
                justify-center
                gap-2
            "
        >
            <span class="rounded-full bg-blue-100 px-3 
                        py-1 text-sm font-medium text-blue-700"> JPG </span>
            
            <span class="rounded-full bg-blue-100 px-3 
                        py-1 text-sm font-medium text-blue-700"> PNG </span>
            
            <span class="rounded-full bg-blue-100 px-3 
                        py-1 text-sm font-medium text-blue-700"> WEBP </span>

            <span class="rounded-full bg-blue-100 px-3 
                        py-1 text-sm font-medium text-blue-700"> AVIF </span>
        </div>
    </div>

    <!-- Information -->
     <div
        class="border-b
        border-slate-200
        px-6
        py-4
        text-sm
        text-slate-500

        dark:border-slate-700
        dark:text-slate-400"
     >
        No Image Selected
     </div>
     <!-- Primary Action -->
     <div class="p-4">
        <button
            class = "
                w-full
                rounded-2xl

                bg-gradient-to-r
                from-blue-600
                via-indigo-500
                to-pink-500

                px-6
                py-4

                font-semibold
                text-white

                transition
                duration-300
                hover:scale-[1.02]
            "
        >
            Select Image
        </button>
     </div>
</div>